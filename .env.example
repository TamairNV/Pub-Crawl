# Root .env (docker compose env_file for the backend, and the tunnel). Names only, never values.
CLOUDFLARE_TUNNEL_TOKEN=
SECRET_KEY=

# Stripe, TEST mode only (values in the keys vault, service pub-crawl)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends people back to (default https://crawl.tamairnv.co.uk)
APP_BASE_URL=
# 1 = free crawls limited to 3 teams. Leave unset until payments are live.
PAYMENTS_ENFORCE=
# 1 = allow sk_live_ keys. Leave unset.
STRIPE_ALLOW_LIVE=
# Stripe product tax code (default txcd_10000000, electronically supplied services)
STRIPE_TAX_CODE=
